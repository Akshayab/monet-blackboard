# Monet Blackboard settings. Copy to .env and fill in one AI key; everything else has a working default.

# ---------- AI model (required: pick one) ----------
# Anthropic: set ANTHROPIC_API_KEY. OpenAI: set OPENAI_API_KEY. If both are set, Anthropic is used unless
# AI_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai | openai-compatible (any server with an OpenAI-style Chat Completions API: Ollama,
# LM Studio, vLLM, OpenRouter...). For openai-compatible, set OPENAI_BASE_URL and AI_MODEL; a key is optional.
# The model must support tool (function) calling. For OpenAI's own models, use AI_PROVIDER=openai instead.
# AI_PROVIDER=
# OPENAI_BASE_URL=http://localhost:11434/v1
# ANTHROPIC_BASE_URL=
# Model name. Defaults: claude-sonnet-5-5 (Anthropic), gpt-6.2-sol (OpenAI).
# AI_MODEL=
# Optional cheaper or faster model for live meeting mode, which sends a request every few sentences.
# AI_LIVE_MODEL=
# low | medium | high (OpenAI reasoning effort). Default: low.
# AI_REASONING_EFFORT=low
# Web search through the provider for questions about current facts. 0 turns it off. Default: on.
# AI_WEB_SEARCH=1

# ---------- Database (required when not using Docker Compose) ----------
# Docker Compose sets this for you.
DATABASE_URL=postgres://localhost:5432/monet

# ---------- Server ----------
# PORT=3000
# Solo mode listens on 127.0.0.1 only. The Docker image sets HOST=0.0.0.0 inside the container.
# HOST=127.0.0.1
# Your display name on boards (you can also change it in the app).
# OWNER_NAME=Owner

# ---------- Team mode (optional) ----------
# Let other people join boards through share links. The server prints an owner link at startup; open it once to
# become the owner in your browser. See "Team mode" in the README before exposing the server.
# TEAM_MODE=1
# The address your team uses, e.g. https://board.example.com. Used for printed links and allowed as an origin.
# PUBLIC_URL=
# Proxies whose X-Forwarded-* headers are trusted (Express "trust proxy" syntax): for https detection and for the
# client address that rate limits use. Default: loopback, linklocal, uniquelocal. Add your proxy's address if it's public.
# TRUST_PROXY=
# Pin the owner link instead of the random one stored in the database (useful for automation).
# OWNER_LINK_TOKEN=
# Set to 1 to make a new owner link at the next start; this also signs the owner out everywhere. Remove it afterwards
# (left set, every restart makes a new link).
# OWNER_LINK_ROTATE=1
# Guests can ask the AI, within their daily limits. 0 turns it off. Default: on.
# GUEST_AI=1
# Extra origins allowed to make changes, comma-separated.
# ALLOWED_ORIGINS=

# ---------- AI spending limits (rolling 24 hours) ----------
# Your own limits as the owner.
# AI_OWNER_DAILY_REQUEST_LIMIT=1000
# AI_OWNER_DAILY_TOKEN_LIMIT=5000000
# AI_OWNER_DAILY_SEARCH_LIMIT=100
# AI_OWNER_CONCURRENT_LIMIT=4
# Each guest's limits (team mode).
# AI_DAILY_REQUEST_LIMIT=40
# AI_DAILY_TOKEN_LIMIT=600000
# AI_DAILY_SEARCH_LIMIT=30
# AI_CONCURRENT_LIMIT=2
# All guests together (team mode). Never counts against the owner's limits. 0 disables that part.
# AI_GUEST_POOL_DAILY_TOKEN_LIMIT=3000000
# AI_GUEST_POOL_DAILY_REQUEST_LIMIT=300
# New guest identities per hour, per IP and per share link.
# RATE_GUEST_JOINS_PER_IP_PER_HOUR=20
# RATE_GUEST_JOINS_PER_LINK_PER_HOUR=60
# AI runs at once on one board.
# AI_BOARD_CONCURRENT_LIMIT=2
# AI runs per client IP per hour (60 in production). 0 disables.
# AI_IP_HOURLY_LIMIT=60
# Set to 1 to turn the AI off for everyone.
# AI_DISABLED=1
# Count usage only from this time (ISO 8601), e.g. after raising your provider's limits.
# AI_USAGE_RESET_AT=

# ---------- Development and testing ----------
# Generous rate limits and the test helpers below need NODE_ENV=development (pnpm dev sets it) or test.
# NODE_ENV=production
# Scripted stand-in model: no key needed, nothing spent. Ignored when NODE_ENV=production.
# AI_MOCK=1
# Deterministic docs and decks without a model call (testing only).
# OUTPUTS_AI_STUB=1
# LOG_LEVEL=info
